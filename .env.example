# Copie para .env e preencha com os valores reais (nunca versionar o .env!)

# Connection string do Neon. No painel do Neon: Connection Details > "Pooled connection".
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.neon.tech/planner_lider?sslmode=require

# String aleatória longa usada pra assinar os tokens de login. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-string-aleatoria-bem-longa

# Origens que podem chamar a API, separadas por vírgula.
ALLOWED_ORIGINS=https://planner.institutodalideranca.com.br

PORT=3000

# E-mail de convite automático ao cadastrar um líder (via Resend — resend.com).
# Crie uma conta gratuita, verifique um domínio (ou use o de testes deles) e
# gere uma API key em Resend > API Keys.
RESEND_API_KEY=re_troque-pela-sua-api-key
# Remetente — precisa ser de um domínio verificado na sua conta Resend.
EMAIL_FROM=Planner do Líder <planner@institutodalideranca.com.br>
# URL do site que aparece no botão do e-mail (padrão já é este se omitido).
FRONTEND_URL=https://planner.institutodalideranca.com.br
